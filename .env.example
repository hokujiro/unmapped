# Copy to .env and fill in values as needed.
# All external data sources used by UNMAPPED are public and require no API keys by default.
# Use these variables only when operators override with private/national data sources.

# Optional: override ILOSTAT base URL (e.g. private national labour database)
# ILOSTAT_BASE_URL=https://sdmx.ilo.org/rest

# Optional: override World Bank WDI base URL
# WDI_BASE_URL=https://api.worldbank.org/v2

# Port for local development
PORT=8000
